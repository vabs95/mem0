{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py block_write",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py block_write --platform=codex",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__mem0__add_memory|mcp__plugin_mem0_mem0__add_memory|mcp__mem0__search_memories|mcp__plugin_mem0_mem0__search_memories|mcp__mem0__get_memories|mcp__plugin_mem0_mem0__get_memories|mcp__mem0__delete_all_memories|mcp__plugin_mem0_mem0__delete_all_memories",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py enforce_metadata",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py enforce_metadata --platform=codex",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py on_file_read",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py on_file_read --platform=codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py session_start",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py session_start --platform=codex",
            "statusMessage": "Loading mem0 context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py user_prompt",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py user_prompt --platform=codex",
            "statusMessage": "Checking memory relevance...",
            "timeout": 12
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__mem0__.*|mcp__plugin_mem0_mem0__.*",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py post_tool_use",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py post_tool_use --platform=codex",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py on_bash_output",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py on_bash_output --platform=codex",
            "timeout": 12
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py stop",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py stop --platform=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM0_PLATFORM=codex python3 ${PLUGIN_ROOT}/scripts/_handlers.py pre_compact",
            "command_windows": "python ${PLUGIN_ROOT}/scripts/_handlers.py pre_compact --platform=codex",
            "statusMessage": "Preparing pre-compaction summary..."
          }
        ]
      }
    ]
  }
}
